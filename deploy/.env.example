# Desenvolvimento local — exemplo canónico
# Copie este ficheiro para .env na raiz do projeto e ajuste apenas o necessário.
# Nunca faça commit do .env real.

DEBUG=True
ALLOWED_HOSTS=

# Segurança
# SECRET_KEY=defina-uma-chave-local-se-pretender

# Base de dados
# Em desenvolvimento local, deixe DB_NAME vazio para usar SQLite automaticamente.
# DB_NAME=infantinho3_dev
# DB_USER=infantinho3
# DB_PASSWORD=dev-password
# DB_HOST=localhost
# DB_PORT=5432

# Email (opcional em dev)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=desenvolvimento@localhost

# Ficheiros
STATIC_URL=/static/
MEDIA_URL=/media/

# Azure AD (opcional em dev; deixar vazio se não testar SSO)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=http://localhost:8000/users/microsoft/callback

# IA (opcional)
AI_FAKE_RESPONSES=True
AI_SERVICE_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=

# MEM / idioma
LANGUAGE_CODE=pt-pt
TIME_ZONE=Europe/Lisbon
MEM_ENABLE=True

